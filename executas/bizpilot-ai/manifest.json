    {
      "name": "validate_business_profile",
      "description": "Validate and normalize a small business profile, currency, tax rate, catalog items, and FAQs.",
      "parameters": {
        "type": "object",
        "properties": {
          "business_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "tax_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "contact_email": {
            "type": "string",
            "maxLength": 200
          },
          "contact_phone": {
            "type": "string",
            "maxLength": 40
