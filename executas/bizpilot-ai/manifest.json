          "catalog": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "unit_price": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "type": "string",
                  "maxLength": 32
                },
                "description": {
                  "type": "string",
                  "maxLength": 400
                }
              },
              "required": [
                "id",
                "name",
                "unit_price"
              ],
              "additionalProperties": false
            }
          },
          "faqs": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "question": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "answer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                }
              },
              "required": [
                "id",
                "question",
                "answer"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "business_name",
          "currency",
          "tax_rate"
        ],
        "additionalProperties": false
      }
    },
